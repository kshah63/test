# Postgres connection string (Neon, Supabase, Render, or local Postgres).
# Example: postgresql://user:password@host:5432/tinysteps?sslmode=require
DATABASE_URL=""

# NextAuth — generate a secret with: openssl rand -base64 32
# NEXTAUTH_URL is auto-detected on Vercel and Render; set it explicitly
# everywhere else (and once you attach a custom domain).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ── Billing ──────────────────────────────────────────────────────────
# Option A (real payments): set Stripe test/live keys.
#   Keys: https://dashboard.stripe.com/test/apikeys
#   Create two recurring prices (monthly, yearly) and put their IDs below.
#   Webhook endpoint: /api/stripe/webhook  (events: checkout.session.completed,
#   customer.subscription.updated, customer.subscription.deleted)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Option B (no Stripe yet): demo billing mode. Upgrades/cancellations are
# instant and free — for TESTING ONLY. In production this must be explicitly
# opted into; without it (and without Stripe keys) billing endpoints return
# 503 instead of silently giving Premium away.
ALLOW_DEMO_BILLING="false"
