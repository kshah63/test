# Database (SQLite for local dev; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Stripe (test-mode keys from https://dashboard.stripe.com/test/apikeys)
# Leave these empty to run in demo billing mode (upgrades happen instantly,
# no card required — for local development only).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
